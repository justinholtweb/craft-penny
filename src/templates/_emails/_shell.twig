{# Plain, table-free HTML. Every mail client renders it, and it is the sort of email a client
   actually reads rather than one that looks like marketing and gets skipped. #}
{% set accent = settings.getAccentColor() %}
<!DOCTYPE html>
<html><head><meta charset="utf-8"></head>
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2328;">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:32px;">
        {% block body %}{% endblock %}
        <p style="margin-top:32px;font-size:13px;color:#6b7280;">
            {{ "Sent by {site}."|t('penny', { site: invite.getSite().getName() }) }}
        </p>
    </div>
</body></html>
