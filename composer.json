{
    "name": "justinholtweb/craft-penny",
    "description": "One-time content invites for Craft CMS — send a client a single-use link that lets them fill in exactly the entries, globals and fields you chose, and nothing else.",
    "version": "5.0.0",
    "type": "craft-plugin",
    "keywords": [
        "craftcms",
        "craft-plugin",
        "one-time-login",
        "magic-link",
        "invite",
        "guest-editing",
        "client",
        "content-collection"
    ],
    "license": "proprietary",
    "homepage": "https://justinholt.com/plugins/craft-penny",
    "authors": [
        {
            "name": "Justin Holt",
            "homepage": "https://justinholt.com"
        }
    ],
    "support": {
        "email": "justin@justinholt.com",
        "docs": "https://justinholt.com/plugins/craft-penny/docs",
        "source": "https://github.com/justinholtweb/craft-penny",
        "issues": "https://github.com/justinholtweb/craft-penny/issues"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "craftcms/cms": "^5.3.0"
    },
    "autoload": {
        "psr-4": {
            "justinholtweb\\penny\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "name": "Penny",
        "handle": "penny",
        "developer": "Justin Holt",
        "developerUrl": "https://justinholt.com",
        "documentationUrl": "https://justinholt.com/plugins/craft-penny/docs",
        "changelogUrl": "https://raw.githubusercontent.com/justinholtweb/craft-penny/main/CHANGELOG.md",
        "class": "justinholtweb\\penny\\Plugin",
        "editions": ["lite", "pro"]
    }
}
